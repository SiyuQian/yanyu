    "meetings.privacy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record and process meetings entirely on this Mac. Recordings and text stay local until you delete them. No automatic model downloads."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会议录音和处理全部在此 Mac 上进行。录音和文字保留在本地，直到手动删除。不会自动下载模型。"
          }
        }
      }
    },
    "meetings.process": {
