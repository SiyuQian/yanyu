    },
    "settings.debug.holdThreshold.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto mode only: how long (in milliseconds) the shortcut must be held before it counts as a hold instead of a tap. Lower if short holds keep leaving recording on; raise if deliberate taps get treated as holds."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅适用于“自动”模式：快捷键需要按住多长时间（毫秒）才算作按住而不是轻按。如果短暂按住后录音仍持续，请调低；如果有意的轻按被当作按住，请调高。"
          }
        }
      }
    },
    "settings.debug.holdThreshold.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold Threshold"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按判定时长"
          }
        }
      }
    },
    "settings.debug.keyboardDiagnostic.description": {
      "localizations": {
        "en": {
