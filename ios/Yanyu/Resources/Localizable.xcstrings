    "settings.advanced.vadBackend.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the detector used to filter silence. Earshot is experimental; switch back to Silero if speech is clipped or noise is retained."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择用于过滤静音的检测器。Earshot 为实验性功能；如果语音被截断或噪音被保留，请切换回 Silero。"
          }
        }
      }
    },
