    "personalization.disclosure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your profile is saved on this device. With local polishing off, daily dictation and optional previews send your transcript and enabled profile context to your configured service. Disabling or deleting excludes profile context from future requests."
          }
