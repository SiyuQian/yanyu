    "personalization.intro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After setup, enabled personalization automatically removes fillers and unintended repetitions from each dictation while preserving meaning and spoken languages. Optional answers supply usage and terminology background."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成设置后，已启用的个性化会在每次听写结束后自动清理口头禅和无意重复，保留原意及中英混说。可选资料提供用途和术语背景。"
          }
        }
      }
    },
    "personalization.later": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Later"
          }
        },
        "zh-Hans": {
