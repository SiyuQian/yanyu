        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装中..."
          }
        }
      }
    },
    "footer.portableUpdateBrowseButton": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open GitHub Releases"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 GitHub Releases"
          }
        }
      }
    },
    "footer.portableUpdateBrowseMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Portable installs cannot be updated automatically. Download the latest version for your system from GitHub Releases and install it to the same folder — your Data/ folder (settings, models, recordings) is kept in place."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "便携版无法自动更新。请从 GitHub Releases 下载适用于你的系统的最新版本，并安装到同一文件夹，你的 Data/ 文件夹（设置、模型、录音）会保留在原处。"
          }
        }
      }
    },
    "footer.portableUpdateButton": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download installer"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载安装程序"
          }
        }
      }
    },
    "footer.portableUpdateMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Portable installs cannot be updated automatically. Download the installer for your system below, run it, and install to the same folder — your Data/ folder (settings, models, recordings) is kept in place."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "便携版无法自动更新。请通过下方按钮下载适用于你的系统的安装程序，运行后安装到同一文件夹，你的 Data/ 文件夹（设置、模型、录音）会保留在原处。"
          }
        }
      }
    },
    "footer.portableUpdateTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manual update required"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要手动更新"
          }
        }
      }
    },
    "footer.preparing": {
      "localizations": {
        "en": {
