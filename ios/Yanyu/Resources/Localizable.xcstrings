    "personalization.advancedGuidance": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom prompts are an explicit alternative to generated cleanup. Returning to custom mode restores legacy shortcut behavior and excludes profile context. The selected custom prompt may change languages or meaning."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义提示词与自动生成的整理规则是两种明确区分的模式。切换回自定义模式后恢复原有快捷键行为，不发送资料背景。选定的自定义提示词可能改变语言或含义。"
          }
        }
      }
    },
