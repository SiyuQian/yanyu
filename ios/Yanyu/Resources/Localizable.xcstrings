    "settings.advanced.pasteMethod.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how text is inserted. Direct: simulates typing via system input. None: skips paste, only updates history/clipboard."
          }
