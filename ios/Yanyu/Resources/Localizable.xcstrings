    "meetings.qualityWarning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaker identity and note accuracy are experimental. Review the full transcript: the small note model can miss tasks or misclassify proposals."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发言人识别和笔记准确性尚处于实验阶段。请核对完整转写：小型笔记模型可能遗漏任务或错误分类提案。"
          }
        }
      }
    },
