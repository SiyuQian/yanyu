    "settings.debug.keyboardDiagnostic.verdictSuspicious": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifier events arrived but no key events — something is suppressing keys even though Secure Input reports disabled. Please report this on GitHub."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收到了修饰键事件，但没有按键事件——尽管 Secure Input 报告为已禁用，仍有程序在抑制按键。请在 GitHub 上反馈此问题。"
          }
        }
      }
