            "state": "translated",
            "value": "以后再说"
          }
        }
      }
    },
    "personalization.localDisclosure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your profile and transcript stay on this Mac during local polishing and local trials. Enabled profile context supplies terminology background only. Disabling or deleting excludes profile context from future requests."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地润色和本地试用期间，资料和转写均保留在这台 Mac 上。已启用的资料仅提供术语背景。禁用或删除后，后续请求不再包含资料背景。"
          }
        }
      }
    },
    "personalization.localPending": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved; enable local polishing and finish model setup"
          }
        },
        "zh-Hans": {
