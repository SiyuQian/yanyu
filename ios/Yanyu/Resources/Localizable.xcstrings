    "errors.loadDirectory": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Error loading directory: {{error}}"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加载目录时出错: {{error}}"
          }
        }
      }
    },
    "errors.micPermissionDenied.generic": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone access was denied by the operating system. Please grant microphone permission in your system settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作系统拒绝了麦克风访问。请在系统设置中授予麦克风权限。"
          }
        }
      }
    },
    "errors.micPermissionDenied.linux": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant microphone access in your system's sound or privacy settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统的声音或隐私设置中授予麦克风访问权限。"
          }
        }
      }
    },
    "errors.micPermissionDenied.macos": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant microphone access in System Settings → Privacy & Security → Microphone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置 → 隐私与安全性 → 麦克风中授予麦克风访问权限。"
          }
        }
      }
    },
    "errors.micPermissionDenied.windows": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable microphone access in Settings → Privacy & security → Microphone (including desktop app access)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设置 → 隐私和安全性 → 麦克风（包括桌面应用访问）中启用麦克风访问。"
          }
        }
      }
    },
    "errors.micPermissionDeniedTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone Access Denied"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风访问被拒绝"
          }
        }
      }
    },
    "errors.modelLoadFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to load model: {{model}}"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加载模型失败: {{model}}"
          }
        }
      }
    },
    "errors.modelLoadFailedUnknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "unknown model"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未知模型"
          }
        }
      }
    },
    "errors.noInputDevice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No audio input device was detected. Please connect a microphone or headset and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未检测到音频输入设备。请连接麦克风或耳机后重试。"
          }
        }
      }
    },
    "errors.noInputDeviceTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Microphone Found"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到麦克风"
          }
        }
      }
    },
    "errors.pasteFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text could not be pasted into the active application."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将文本粘贴到当前活动的应用程序中。"
          }
        }
      }
    },
    "errors.pasteFailedTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to Paste Text"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴文本失败"
          }
        }
      }
    },
    "errors.recordingFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to start recording: {{error}}"
          }
