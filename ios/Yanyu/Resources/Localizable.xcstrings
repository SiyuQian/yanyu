      }
    },
    "iosApp.deleteAllHistory": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete all transcript history"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除所有转写历史"
          }
        }
      }
    },
    "iosApp.deleteAllHistoryConfirmation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete all saved transcripts?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要删除所有已保存的转写吗？"
          }
        }
      }
    },
    "iosApp.deleteAllHistoryHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently remove every saved transcript from this iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永久删除此 iPhone 上保存的所有转写。"
          }
        }
      }
    },
    "iosApp.deleteHistoryFailedBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanyu could not save this change. Your transcript history is still available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "言语无法保存此更改，转写历史仍可使用。"
          }
        }
