    "iosApp.audioCleanupFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanyu couldn't remove the temporary recording. Delete it before starting another recording."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法删除临时录音。请先删除它，再开始新的录音。"
          }
        }
      }
    },
    "iosApp.audioInterrupted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording stopped because audio was interrupted. The captured audio is kept so you can retry or delete it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音因音频中断而停止。已保留录音，你可以重试转写或删除它。"
          }
        }
      }
    },
    "iosApp.audioRouteChanged": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording stopped because the audio route changed. The captured audio is kept so you can retry or delete it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音因音频设备切换而停止。已保留录音，你可以重试转写或删除它。"
          }
        }
      }
    },
    "iosApp.audioTooLong": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This recording exceeds the current model's duration limit. Delete it and record a shorter clip."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这段录音超过了当前模型支持的时长。请删除录音并录制更短的片段。"
          }
        }
      }
    },
    "iosApp.backgroundTranscriptionStopped": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription paused when Yanyu moved to the background. The captured audio is kept so you can retry or delete it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "言语进入后台后暂停了转写。已保留录音，你可以重试转写或删除它。"
          }
        }
      }
    },
    "iosApp.cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel transcription"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消转写"
          }
        }
      }
    },
    "iosApp.cancelModelDownload": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel download"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消下载"
          }
        }
      }
    },
    "iosApp.continue": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续"
          }
        }
      }
    },
    "iosApp.copied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copied"
          }
        },
