    "meetings.errors.capture_disk_error": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording stopped because a file could not be written. Free disk space and retry processing the audio already committed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件写入失败，录音已停止。请释放磁盘空间后重试处理已保存的音频。"
          }
        }
      }
    },
    "meetings.errors.capture_interrupted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording was interrupted. Review recovered audio and retry processing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音已中断。请检查恢复的音频后重试处理。"
          }
        }
      }
    },
    "meetings.errors.microphone_permission_denied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone access was denied. Allow it in System Settings → Privacy & Security → Microphone, then start again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风访问被拒绝。请在「系统设置 → 隐私与安全性 → 麦克风」允许访问，然后重新开始。"
          }
        }
      }
    },
    "meetings.errors.missing_moss_model": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install MOSS-Transcribe-Diarize explicitly from Models, then retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在「模型」手动安装 MOSS-Transcribe-Diarize，然后重试。"
          }
        }
      }
    },
    "meetings.errors.missing_qwen_model": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download Qwen3-0.6B explicitly in General → Local polishing, then retry. Enabling dictation polishing is optional."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在「常规 → 本地润色」手动下载 Qwen3-0.6B，然后重试。无需启用听写润色。"
          }
        }
      }
    },
    "meetings.errors.playback_failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Playback failed. Check that the retained recording is available and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回放失败。请检查保留的录音是否可用，然后重试。"
          }
        }
      }
    },
    "meetings.errors.processing_cancelled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local processing was cancelled. Completed transcript windows and existing notes are retained. Retry when ready."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地处理已取消。已完成的转写片段和现有笔记仍保留，可稍后重试。"
          }
        }
      }
    },
    "meetings.errors.processing_failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation failed. Your retained recording and completed text are preserved. Check permissions, installed models, and free disk space, then retry. Technical details describe the failure."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作失败。保留的录音和已完成文字仍在。请检查权限、已安装模型和磁盘空间后重试。技术详情中提供了失败原因。"
          }
        }
      }
    },
    "meetings.errors.processing_interrupted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local processing was interrupted. The recording and completed transcript windows are retained. Retry to continue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地处理已中断。录音和已完成的转写片段仍保留，请重试以继续。"
          }
        }
      }
    },
    "meetings.errors.system_audio_interrupted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer audio was interrupted. The meeting capture is incomplete; review retained audio before retrying processing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑音频已中断，会议录音不完整。请检查保留的音频后重试处理。"
          }
        }
      }
    },
    "meetings.errors.system_audio_permission_denied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer audio access was denied. Allow Screen & System Audio Recording in System Settings → Privacy & Security, restart the app if requested, then start again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑音频访问被拒绝。请在「系统设置 → 隐私与安全性」允许屏幕与系统音频录制，按提示重启应用后重新开始。"
          }
        }
      }
    },
    "meetings.errors.system_audio_unavailable": {
      "localizations": {
