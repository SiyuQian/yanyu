            "state": "translated",
            "value": "Secure Input is blocking key events — keyed shortcuts cannot work until it is resolved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Secure Input 正在阻止按键事件——在问题解决前，包含普通按键的快捷键无法工作。"
          }
        }
      }
    },
    "settings.debug.keyboardDiagnostic.verdictNoEvents": {
