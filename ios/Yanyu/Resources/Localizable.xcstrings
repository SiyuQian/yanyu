{
  "sourceLanguage": "en",
  "strings": {
    "accessibility.openSettings": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开系统设置"
          }
        }
      }
    },
    "accessibility.permissionsDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanyu needs accessibility permissions to type transcribed text."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "言语需要辅助功能权限才能输入转录的文字。"
          }
        }
      }
    },
    "app.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "言语"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "言语"
          }
        }
      }
    },
    "app.version": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "言语 · Yanyu v{{version}}"
