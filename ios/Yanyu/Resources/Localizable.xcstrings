    "iosApp.onboardingBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanyu records only when you ask. Speech is transcribed on this iPhone. Temporary audio is deleted after the transcript is saved; if something fails, it stays here so you can retry or delete it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你主动操作时，言语才会录音。语音只在这台 iPhone 上转写。转写保存后会删除临时音频；如果处理失败，录音会留在本机供你重试或删除。"
          }
        }
      }
    },
