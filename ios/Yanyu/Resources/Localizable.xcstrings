        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音启动失败: {{error}}"
          }
        }
      }
    },
    "errors.transcriptionFailedTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription Failed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转录失败"
          }
        }
      }
    },
