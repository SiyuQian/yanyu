    "settings.localPolishing.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservatively clean up speech using Qwen3-0.6B on this Mac. Enabled personalization supplies terminology context only. Without it, use basic cleanup. Preserve meaning and spoken languages. Inputs over 200 characters skip polishing. Keep the original if the model is unavailable, output is invalid or processing exceeds 500 ms. Turning this off releases the loaded model."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这台 Mac 上用 Qwen3-0.6B 保守清理语音。已启用的个性化资料仅提供术语背景，未启用时使用基础清理规则。保留原意和所说语言。超过 200 字的输入跳过润色。模型不可用、输出无效或处理超过 500 毫秒时保留原文。关闭后释放已加载模型。"
          }
        }
      }
    },
