    "personalization.localReady": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enabled; automatic local polishing ready"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已启用；每次听写将自动在本机润色"
          }
        }
      }
    },
    "personalization.localTrialInfo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional one-minute trial. Recording and stopping processes recognized text on this Mac using the same local polishing as daily dictation. No external service fallback. Preview only, with no paste, messages, history or saved audio. This sample does not prove a general accuracy gain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选的一分钟试用：录音并停止后，在这台 Mac 上使用与日常听写相同的本地润色处理转写，不回退到外部服务。仅预览，不粘贴、不发送消息、不写入历史或保存录音。该样本不能证明整体准确率提高。"
          }
        }
      }
    },
    "personalization.localTrialSucceeded": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local polishing returned a usable result for this sample. Check that meaning and languages were preserved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地润色为该样本返回了可用结果。请检查原意和语言是否保留。"
          }
        }
      }
    },
    "personalization.modeDisclosure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic processing uses fixed conservative rules and optional terminology context. Saved custom prompts remain on disk and do not affect this cleanup. Cleanup aims to preserve meaning, languages, emphasis, negations and instructions. Uncertain repetitions stay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动处理使用固定的保守规则和可选术语背景。已保存的自定义提示词仍保留在磁盘上，不影响此清理。清理旨在保留原意、语言、强调、否定和指令。不确定的重复保持原样。"
          }
        }
      }
    },
