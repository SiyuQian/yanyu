    "settings.advanced.acceleration.ort.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hardware acceleration for ONNX models (Parakeet, Canary, Moonshine, etc.). DirectML on Windows is experimental. Models may fail to transcribe."
          }
